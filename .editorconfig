# エディタ層の最小規約。整形の権威は biome（ADR 0002）であり、
# ここは biome が見ないファイル（Makefile / *.mk / *.md / *.toml 等）と
# 保存時の既定挙動を揃えるためだけに置く。値は biome.json と一致させること。
root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true

# Markdown は行末 2 スペースが改行を意味するため除去しない
[*.md]
trim_trailing_whitespace = false

# make はレシピ行にタブを要求する
[{Makefile,*.mk}]
indent_style = tab
