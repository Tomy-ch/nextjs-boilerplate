{
  "name": "branch-protection",
  "target": "branch",
  "source_type": "Repository",
  "enforcement": "active",
  "conditions": {
    "ref_name": {
      "exclude": [],
      "include": [
        "refs/heads/production",
        "refs/heads/staging",
        "refs/heads/develop",
        "refs/heads/release/**/*",
        "refs/heads/hotfix/**/*"
      ]
    }
  },
  "rules": [
    {
      "type": "deletion"
    },
    {
      "type": "non_fast_forward"
    },
    {
      "type": "pull_request",
      "parameters": {
        "required_approving_review_count": 1,
        "dismiss_stale_reviews_on_push": true,
        "required_reviewers": [],
        "require_code_owner_review": false,
        "require_last_push_approval": true,
        "required_review_thread_resolution": true,
        "allowed_merge_methods": ["merge", "squash"]
      }
    },
    {
      "type": "copilot_code_review",
      "parameters": {
        "review_on_push": true,
        "review_draft_pull_requests": true
      }
    },
    {
      "type": "code_quality",
      "parameters": {
        "severity": "errors"
      }
    },
    {
      "type": "required_status_checks",
      "parameters": {
        "strict_required_status_checks_policy": true,
        "do_not_enforce_on_create": false,
        "required_status_checks": [
          { "context": "a11y" },
          { "context": "actions-lint" },
          { "context": "actions-pin" },
          { "context": "build" },
          { "context": "gen-drift" },
          { "context": "images-pin" },
          { "context": "lint" },
          { "context": "lockfile-drift" },
          { "context": "md-lint" },
          { "context": "scripts-check" },
          { "context": "smoke" },
          { "context": "storybook-build" },
          { "context": "test" },
          { "context": "tokens-drift" },
          { "context": "typecheck" },
          { "context": "vrt" }
        ]
      }
    }
  ],
  "bypass_actors": []
}
