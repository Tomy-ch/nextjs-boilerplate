{
  "name": "nextjs-boilerplate",
  "version": "0.3.0",
  "private": true,
  "license": "MIT",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "biome check",
    "lint:eslint": "eslint .",
    "lint:ci": "biome check --config-path=./biome.ci.jsonc --error-on-warnings && pnpm lint:eslint && pnpm check:architecture",
    "check:architecture": "tsx scripts/architecture/check-boundaries.ts",
    "fix": "biome check --fix",
    "format": "biome format --write",
    "gen:tokens": "tsx tokens/scripts/gen-tokens.ts",
    "check:tokens": "tsx tokens/scripts/gen-tokens.ts --check",
    "add:ui": "tsx src/components/scripts/add-shadcn.ts",
    "check:ui": "tsx src/components/scripts/check-shadcn.ts",
    "check:classes": "tsx src/components/scripts/check-classes.ts",
    "design:bundle": "tsx scripts/design-bundle.ts",
    "portal:guides": "tsx scripts/portal/gen-portal-docs.ts",
    "portal:docs": "tsx scripts/portal/gen-docs-json.ts",
    "portal:build": "pnpm portal:guides && pnpm portal:docs && pnpm --filter docs-viewer build",
    "portal:site": "pnpm portal:build && tsx scripts/portal/build-site.ts",
    "portal:preview": "pnpm portal:site && vite preview --outDir dist",
    "typecheck": "tsc --noEmit",
    "md-lint": "markdownlint-cli2 && tsx scripts/mermaid-lint.ts && tsx scripts/skill-lint.ts",
    "md-fix": "markdownlint-cli2 --fix",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "test": "vitest run --coverage --no-cache",
    "test:cached": "vitest run",
    "test:light": "vitest run --coverage --no-cache --maxWorkers=4"
  },
  "dependencies": {
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/api-logs": "0.221.0",
    "@opentelemetry/core": "2.10.0",
