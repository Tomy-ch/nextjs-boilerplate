    "tailwindcss": "4.3.3",
    "tsx": "4.23.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.65.0",
    "vite": "8.1.0",
    "vitest": "4.1.10",
    "vitest-axe": "0.1.0",
    "yaml": "2.9.0"
  }
