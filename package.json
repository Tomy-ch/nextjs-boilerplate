{
  "name": "nextjs-boilerplate",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "biome check",
    "lint:eslint": "eslint .",
    "lint:ci": "biome check --config-path=./biome.ci.jsonc --error-on-warnings && pnpm lint:eslint",
    "fix": "biome check --fix",
    "format": "biome format --write",
    "gen:tokens": "tsx tokens/scripts/gen-tokens.ts",
    "check:tokens": "tsx tokens/scripts/gen-tokens.ts --check",
    "typecheck": "tsc --noEmit",
    "md-lint": "markdownlint-cli2 && tsx scripts/mermaid-lint.ts && tsx scripts/skill-lint.ts",
    "md-fix": "markdownlint-cli2 --fix",
    "test": "vitest run --coverage --no-cache",
    "test:cached": "vitest run"
  },
  "dependencies": {
    "clsx": "2.1.1",
    "dotenv": "17.4.2",
    "next": "16.2.11",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "0.0.1",
    "tailwind-merge": "3.6.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.5",
    "@commitlint/cli": "21.2.1",
    "@commitlint/types": "21.2.0",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "7.0.0",
    "@testing-library/react": "16.3.2",
    "@types/node": "26.1.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.4",
    "@vitest/coverage-v8": "4.1.10",
    "eslint": "10.8.0",
    "eslint-plugin-boundaries": "7.1.0",
    "jsdom": "29.0.1",
    "lefthook": "2.1.10",
    "linkedom": "0.18.13",
    "markdownlint-cli2": "0.23.1",
    "mermaid": "11.16.0",
    "msw": "2.15.0",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.65.0",
    "vitest": "4.1.10",
    "vitest-axe": "0.1.0",
    "yaml": "2.9.0"
  }
}
