      "$value": "{color.cyan.510}"
    },
    "accent": {
      "$type": "color",
      "$value": "{color.slate.960}"
    },
    "accent-foreground": {
      "$type": "color",
      "$value": "{color.slate.60}"
    },
    "border": {
