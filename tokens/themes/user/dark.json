      "$value": "{color.slate.990}"
    },
    "foreground": {
      "$type": "color",
      "$value": "{color.slate.60}"
    },
    "card": {
      "$type": "color",
      "$value": "color-mix(in srgb, {color.slate.980} 76%, transparent)"
    },
    "card-foreground": {
      "$type": "color",
      "$value": "{color.slate.60}"
    },
    "popover": {
      "$type": "color",
      "$value": "{color.slate.975}"
