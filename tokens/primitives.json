{
  "color": {
    "neutral": {
      "0": { "$type": "color", "$value": "#ffffff" },
      "100": { "$type": "color", "$value": "#ededed" },
      "700": { "$type": "color", "$value": "#404040" },
      "900": { "$type": "color", "$value": "#171717" },
      "950": { "$type": "color", "$value": "#0a0a0a" }
    }
  },
  "spacing": {
    "0": { "$type": "dimension", "$value": "0px" },
    "1": { "$type": "dimension", "$value": "0.25rem" },
    "2": { "$type": "dimension", "$value": "0.5rem" },
    "4": { "$type": "dimension", "$value": "1rem" },
    "6": { "$type": "dimension", "$value": "1.5rem" },
    "8": { "$type": "dimension", "$value": "2rem" }
  },
  "radius": {
    "none": { "$type": "dimension", "$value": "0px" },
    "sm": { "$type": "dimension", "$value": "0.125rem" },
    "md": { "$type": "dimension", "$value": "0.375rem" },
    "lg": { "$type": "dimension", "$value": "0.5rem" }
  },
  "font": {
    "sans": { "$type": "fontFamily", "$value": ["var(--font-geist-sans)", "Arial", "sans-serif"] },
    "mono": { "$type": "fontFamily", "$value": ["var(--font-geist-mono)", "monospace"] }
  }
}
