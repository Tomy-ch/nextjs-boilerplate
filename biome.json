{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignoreUnknown": true,
    "maxSize": 1048576,
    "includes": [
      "**",
      "!!**/node_modules",
      "!!**/.next",
      "!!**/dist",
      "!!**/build",
      "!!**/types",
      "!**/*.md"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100,
    "lineEnding": "lf"
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "jsxQuoteStyle": "double",
      "semicolons": "always",
      "trailingCommas": "all",
      "arrowParentheses": "always"
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "suspicious": {
        "noUnknownAtRules": "off",
        "noConsole": "warn",
        "noExplicitAny": "error",
        "noConstantBinaryExpressions": "error",
        "noLeakedRender": "error",
        "noReactForwardRef": "warn",
        "noNestedPromises": "warn",
        "noShadow": "warn",
        "noAlert": "on",
        "noDeprecatedImports": "on",
        "noDuplicateDependencies": "on",
        "noDuplicatedSpreadProps": "on",
        "noEvolvingTypes": "on",
        "noParametersOnlyUsedInRecursion": "on",
        "noReturnAssign": "on",
        "noUnassignedVariables": "on",
        "noUnknownAttribute": "on",
        "noUnusedExpressions": "on",
        "noVar": "on",
        "useStaticResponseMethods": "on"
      },
      "correctness": {
        "noUnusedImports": "error",
        "noUnusedVariables": "error",
        "noUndeclaredDependencies": "error",
        "noNestedComponentDefinitions": "error",
        "noNextAsyncClientComponent": "error",
        "noGlobalDirnameFilename": "on",
        "noReactPropAssignments": "on",
        "noUnusedInstantiation": "on",
        "useUniqueElementIds": "on"
      },
      "nursery": {
        "noComponentHookFactories": "error",
        "useIframeSandbox": "warn",
        "noJsxLeakedDollar": "warn"
      },
      "performance": {
        "noSyncScripts": "on",
        "noJsxPropsBind": "on",
        "noAwaitInLoops": "on",
        "noDelete": "on"
      },
      "style": {
        "noProcessEnv": "error"
      }
    },
    "domains": {
      "next": "recommended",
      "react": "recommended"
    }
  },
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "overrides": [
    {
      "includes": ["src/adapters/gen/**", "mocks/*/**"],
      "linter": {
        "enabled": false
      }
    },
    {
      "includes": [".vscode/**"],
      "json": {
        "parser": {
          "allowComments": true
        }
      }
    },
    {
      "includes": ["**/*.d.ts"],
      "linter": {
        "rules": {
          "suspicious": {
            "noExplicitAny": "off"
          }
        }
      }
    },
    {
      "includes": ["src/config/**"],
      "linter": {
        "rules": {
          "style": {
            "noProcessEnv": "off"
          }
        }
      }
    },
    {
      "includes": ["src/instrumentation.ts"],
      "linter": {
        "rules": {
          "style": {
            "noProcessEnv": "off"
          }
        }
      }
    },
    {
      "includes": ["scripts/**"],
      "linter": {
        "rules": {
          "suspicious": {
            "noConsole": "off",
            "noExplicitAny": "off"
          },
          "style": {
            "noProcessEnv": "off"
          }
        }
      }
    },
    {
      "includes": ["public/**"],
      "linter": {
        "rules": {
          "a11y": {
            "noSvgWithoutTitle": "off"
          }
        }
      }
    },
    {
      "includes": ["vrt/**"],
      "linter": {
        "rules": {
          "correctness": {
            "noEmptyPattern": "off"
          }
        }
      }
    }
  ],
  "css": {
    "parser": {
      "cssModules": true,
      "tailwindDirectives": true
    }
  }
}
